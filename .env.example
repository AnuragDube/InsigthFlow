# Copy to .env (gitignored) and adjust. Never commit real secrets.
INSIGHTFLOW_ENVIRONMENT=dev
INSIGHTFLOW_DATA_DIR=data
INSIGHTFLOW_DATABASE_URL=sqlite:///data/metadata.sqlite3
INSIGHTFLOW_SAMPLE_DIR=data/samples/uci
INSIGHTFLOW_MAX_UPLOAD_MB=200
INSIGHTFLOW_DUCKDB_MEMORY_LIMIT=2GB
